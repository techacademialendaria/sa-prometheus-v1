# Variables required by entrypoint.sh. Set them in the Railway service; never commit real values.
#
# Generate the password and its hash without printing them:
#   PASSWORD="$(openssl rand -base64 30 | tr -d '/+=' | cut -c1-32)"
#   HASH="$(printf '%s\n' "$PASSWORD" | htpasswd -niB performance | cut -d: -f2)"

# bcrypt hash of the password for user "performance"
PROM_AUTH_HASH=

# The password itself, used by the self-scrape job (prometheus.yml)
PROM_AUTH_PASSWORD=

# The image runs as "nobody" and Railway volumes are owned by root
RAILWAY_RUN_UID=0
